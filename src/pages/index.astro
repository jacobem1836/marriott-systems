---
import Base from "../layouts/Base.astro";

interface Venture {
  index: string;
  kind: string;
  title: string;
  body: string;
  href: string;
  cta: string;
  external: boolean;
  flagship?: boolean;
  ctas?: { label: string; href: string }[];
}

const ventures: Venture[] = [
  {
    index: "01",
    kind: "product – flagship",
    title: "Brain Console",
    body: "A business-wide AI brain – persistent memory, tool execution, and one place that actually knows your company. Every employee gets an AI that answers in your voice, from your knowledge, with the sources attached.",
    href: "https://console.marriottsystems.net",
    cta: "see brain console",
    external: true,
    flagship: true,
  },
  {
    index: "04",
    kind: "product – early access",
    title: "dAIly",
    body: "A voice-first morning brief – your email, calendar, Slack, and messages, synthesised, prioritised, and spoken to you before you open a single app.",
    href: "https://getdaily.dev",
    cta: "get early access",
    external: true,
  },
  {
    index: "02",
    kind: "service",
    title: "AI systems consulting",
    body: "Personalised AI systems for professionals and business owners – structured Claude Code environments, custom skills, knowledge graphs, and automation, built around how each client actually works.",
    href: "/consulting",
    cta: "see consulting",
    external: false,
  },
  {
    index: "03",
    kind: "service",
    title: "Hospitality",
    body: "Websites and operational systems for independent venues – visibility audits, custom rebuilds, and dashboards that pull POS, bookings, and accounting into one place.",
    href: "/hospitality",
    cta: "see the offer",
    external: false,
    ctas: [
      { label: "see websites", href: "/web" },
      { label: "see operations", href: "/hospitality" },
    ],
  },
  {
    index: "05",
    kind: "founder",
    title: "Jacob Marriott",
    body: "Software engineer and founder – agentic AI, full-stack systems, and a portfolio of shipped work. Studying software engineering at UQ.",
    href: "https://jacobmarriott.com",
    cta: "about the founder",
    external: true,
  },
];

// Grouped for the flagship / service-pair / lab+founder layout — derived
// entirely from the existing `kind` field, no reordering of the source data.
const flagship = ventures.find((v) => v.flagship) as Venture;
const serviceVentures = ventures.filter((v) => v.kind === "service");
const miniVentures = ventures.filter((v) => !v.flagship && v.kind !== "service");

// Hero terminal cycles through the page's own CTA copy — no invented lines.
const terminalLines = ventures.map((v) => v.cta);
const flagshipDomain = flagship.href.replace(/^https?:\/\//, "");
---

<Base>
  <section class="hero container" aria-labelledby="hero-heading">
    <p class="section-label" data-reveal>
      <span aria-hidden="true">01 / </span>company
    </p>
    <h1 id="hero-heading" class="hero__headline" data-reveal>
      Marriott Systems
      <span class="hero__headline-soft">AI products and operational systems, built in Brisbane.</span>
    </h1>
    <p class="hero__lede" data-reveal>
      Marriott Systems is the company behind <a href="https://console.marriottsystems.net">Brain Console</a>
      and <a href="https://getdaily.dev">dAIly</a>, alongside a consulting practice building AI systems, websites, and
      operational systems for businesses across Australia and New Zealand. Founded and run by
      <a href="https://jacobmarriott.com">Jacob Marriott</a>.
    </p>
    <p class="hero__meta mono" data-reveal>
      <span>brisbane, au</span>
      <span class="hero__meta-dot" aria-hidden="true">·</span>
      <span>est. 2026</span>
      <span class="caret" aria-hidden="true"></span>
    </p>

    <div class="hero__terminal terminal" data-reveal aria-hidden="true">
      <div class="terminal__bar">
        <span class="terminal__dot"></span>
        <span class="terminal__dot"></span>
        <span class="terminal__dot"></span>
        <span class="terminal__label">marriott-systems</span>
      </div>
      <div class="terminal__body" data-terminal-lines={JSON.stringify(terminalLines)}>
        <span class="terminal__prompt">»&nbsp;</span><span data-terminal-text>{terminalLines[0]}</span><span class="caret"></span>
      </div>
    </div>
  </section>

  <section class="ventures container" aria-labelledby="ventures-heading">
    <p class="section-label" data-reveal>
      <span aria-hidden="true">02 / </span>ventures
    </p>
    <h2 id="ventures-heading" class="visually-hidden">Ventures and services</h2>

    <article class="venture-flagship card card--lg" data-reveal>
      <div class="venture-flagship__copy">
        <div class="venture-flagship__meta">
          <p class="venture-flagship__index mono" aria-hidden="true">{flagship.index}</p>
          <span class="tag">flagship</span>
        </div>
        <h3 class="venture-flagship__title">
          {flagship.external ? (
            <a class="venture-flagship__link" href={flagship.href} target="_blank" rel="noopener noreferrer">
              {flagship.title}
              <span class="venture-flagship__arrow" aria-hidden="true">↗</span>
              <span class="visually-hidden">(opens in a new tab)</span>
            </a>
          ) : (
            <a class="venture-flagship__link" href={flagship.href}>
              {flagship.title}
              <span class="venture-flagship__arrow" aria-hidden="true">→</span>
            </a>
          )}
        </h3>
        <p class="venture-flagship__kind mono">{flagship.kind}</p>
        <p class="venture-flagship__body">{flagship.body}</p>
        <div class="venture-flagship__chips">
          <span class="chip">memory</span>
          <span class="chip">tool execution</span>
          <span class="chip">sources attached</span>
        </div>
        {flagship.external ? (
          <a class="btn-pill" href={flagship.href} target="_blank" rel="noopener noreferrer">
            {flagship.cta} <span aria-hidden="true">→</span>
          </a>
        ) : (
          <a class="btn-pill" href={flagship.href}>
            {flagship.cta} <span aria-hidden="true">→</span>
          </a>
        )}
      </div>
      <div class="venture-flagship__terminal terminal terminal--inset" aria-hidden="true">
        <div class="terminal__bar">
          <span class="terminal__dot"></span>
          <span class="terminal__dot"></span>
          <span class="terminal__dot"></span>
          <span class="terminal__label">{flagshipDomain}</span>
        </div>
        <div class="terminal__body">
          <p><span class="terminal__prompt">»&nbsp;</span>{flagship.cta}<span class="caret"></span></p>
        </div>
      </div>
    </article>

    <div class="grid-cards">
      {serviceVentures.map((v) => (
        <article class="card venture-card" data-reveal>
          <p class="venture-card__meta mono">
            <span aria-hidden="true">{v.index} / </span>{v.kind}
          </p>
          <h3 class="venture-card__title">
            <a class="venture-card__link" href={v.href}>
              {v.title}
              <span class="venture-card__arrow" aria-hidden="true">→</span>
            </a>
          </h3>
          <p class="venture-card__body">{v.body}</p>
          {v.ctas ? (
            v.ctas.map((c) => (
              <a class="link-cta venture-card__cta" href={c.href}>
                {c.label} <span class="link-cta__arrow" aria-hidden="true">→</span>
              </a>
            ))
          ) : (
            <a class="link-cta venture-card__cta" href={v.href}>
              {v.cta} <span class="link-cta__arrow" aria-hidden="true">→</span>
            </a>
          )}
        </article>
      ))}
    </div>

    <div class="grid-cards">
      {miniVentures.map((v) => (
        <article class="card card--ghost venture-mini" data-reveal>
          <p class="venture-mini__kind mono">
            <span aria-hidden="true">{v.index} / </span>{v.kind}
          </p>
          <h4 class="venture-mini__title">
            {v.external ? (
              <a class="venture-mini__link" href={v.href} target="_blank" rel="noopener noreferrer">
                {v.title}
                <span class="venture-mini__arrow" aria-hidden="true">↗</span>
                <span class="visually-hidden">(opens in a new tab)</span>
              </a>
            ) : (
              <a class="venture-mini__link" href={v.href}>
                {v.title}
                <span class="venture-mini__arrow" aria-hidden="true">→</span>
              </a>
            )}
          </h4>
          <p class="venture-mini__body">{v.body}</p>
          {v.external ? (
            <a class="link-cta venture-mini__cta" href={v.href} target="_blank" rel="noopener noreferrer">
              {v.cta} <span class="link-cta__arrow" aria-hidden="true">→</span>
            </a>
          ) : (
            <a class="link-cta venture-mini__cta" href={v.href}>
              {v.cta} <span class="link-cta__arrow" aria-hidden="true">→</span>
            </a>
          )}
        </article>
      ))}
    </div>
  </section>

  <script is:inline src="/home.js"></script>
</Base>

<style>
  /* ---------- Hero ---------- */

  .hero {
    /* main > section:first-child zeroes padding-top/border-top globally;
       restore top clearance now that the header is sticky-in-flow rather
       than absolutely positioned. Bottom padding is inherited. */
    padding-top: var(--space-section);
    display: grid;
    gap: var(--space-6);
  }

  .hero__headline {
    font-size: var(--text-hero);
  }

  .hero__headline-soft {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    font-weight: 400;
    letter-spacing: normal;
    line-height: var(--leading-snug);
    color: var(--muted);
    max-width: 32ch;
    margin-top: var(--space-4);
  }

  .hero__lede {
    font-size: var(--text-base);
    color: var(--muted);
    max-width: 56ch;
    line-height: var(--leading-prose);
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .hero__meta-dot {
    color: var(--muted);
  }

  .hero__terminal {
    max-width: 640px;
    margin-top: var(--space-2);
  }

  /* ---------- Ventures ---------- */

  .ventures {
    display: grid;
    gap: var(--space-8);
  }

  .venture-flagship {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(1.5rem, 1rem + 3vw, 2.75rem);
    align-items: center;
  }

  .venture-flagship__copy {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
  }

  .venture-flagship__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .venture-flagship__index {
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .venture-flagship__title {
    font-size: var(--text-2xl);
  }

  .venture-flagship__link {
    color: inherit;
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
    border-bottom: 0;
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .venture-flagship__link:hover,
  .venture-flagship__link:focus-visible {
    color: var(--accent);
    border-bottom: 0;
  }

  .venture-flagship__arrow {
    font-size: 0.6em;
    color: var(--muted);
    transition: color var(--duration-fast) var(--ease-out-expo),
                transform var(--duration-fast) var(--ease-out-expo);
  }

  .venture-flagship__link:hover .venture-flagship__arrow,
  .venture-flagship__link:focus-visible .venture-flagship__arrow {
    color: var(--accent);
    transform: translate(0.1em, -0.1em);
  }

  .venture-flagship__kind {
    font-size: var(--text-xs);
    color: var(--accent);
    text-transform: lowercase;
  }

  .venture-flagship__body {
    font-size: var(--text-base);
    color: var(--text);
    max-width: 44ch;
  }

  .venture-flagship__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .venture-flagship__terminal {
    min-width: 0;
  }

  /* ---------- Service pair + lab/founder mini cards ---------- */

  .venture-card,
  .venture-mini {
    display: flex;
    flex-direction: column;
  }

  .venture-card__meta,
  .venture-mini__kind {
    font-size: var(--text-xs);
    color: var(--muted);
    text-transform: lowercase;
  }

  .venture-card__title,
  .venture-mini__title {
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .venture-card__title {
    font-size: var(--text-xl);
  }

  .venture-mini__title {
    font-size: var(--text-lg);
  }

  .venture-card__link,
  .venture-mini__link {
    color: inherit;
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
    border-bottom: 0;
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .venture-card__link:hover,
  .venture-card__link:focus-visible,
  .venture-mini__link:hover,
  .venture-mini__link:focus-visible {
    color: var(--accent);
    border-bottom: 0;
  }

  .venture-card__arrow,
  .venture-mini__arrow {
    font-size: 0.65em;
    color: var(--muted);
    transition: color var(--duration-fast) var(--ease-out-expo),
                transform var(--duration-fast) var(--ease-out-expo);
  }

  .venture-card__link:hover .venture-card__arrow,
  .venture-card__link:focus-visible .venture-card__arrow,
  .venture-mini__link:hover .venture-mini__arrow,
  .venture-mini__link:focus-visible .venture-mini__arrow {
    color: var(--accent);
    transform: translate(0.1em, -0.1em);
  }

  .venture-card__body {
    font-size: var(--text-sm);
    color: var(--muted);
    max-width: 42ch;
  }

  .venture-mini__body {
    font-size: var(--text-xs);
    color: var(--muted);
    max-width: 40ch;
  }

  .venture-card__cta,
  .venture-mini__cta {
    margin-top: auto;
    padding-top: var(--space-4);
  }
</style>
