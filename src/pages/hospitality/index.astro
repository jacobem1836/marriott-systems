---
import Base from "../../layouts/Base.astro";

const services = [
  {
    index: "01",
    name: "Operations systems",
    price: "builds from $1.5k, fixed scope",
    body: "Custom operational systems that pull a venue's existing tools – POS, bookings, accounting, and rostering – into one place. Engagements start with a free fit-check call and a short operations audit ($300–600) that maps where the numbers live and which changes are worth making first.",
  },
  {
    index: "02",
    name: "Ongoing care",
    price: "$400–800/mo",
    body: "Maintenance, one small improvement each month, and asynchronous support.",
  },
];

const stats = [
  { value: "$1.5k", label: "systems build, from" },
  { value: "$300–600", label: "operations audit" },
  { value: "$400–800/mo", label: "ongoing care" },
];

const faqs = [
  {
    q: "Is there a contract or lock-in?",
    a: "No. There is no contract, and data can be exported at any time.",
  },
  {
    q: "What if a venue isn't running Square or Lightspeed?",
    a: "Systems are also built around Kounta and ResDiary. Most other point-of-sale and accounting tools export to CSV, which works just as well – what's feasible for a specific setup gets worked out during the Fit Check.",
  },
  {
    q: "What happens on the Fit Check call?",
    a: "A free 30-minute call, no pitch – an honest look at whether the system fits a venue's existing POS and accounting setup, and whether it's worth building at all.",
  },
];

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Marriott Systems – Hospitality Operations",
  "url": "https://marriottsystems.net/hospitality",
  "description": "Custom operational systems for Brisbane restaurants, cafes, and bars – pulling POS, bookings, and accounting into one place.",
  "areaServed": { "@type": "City", "name": "Brisbane" },
  "address": { "@type": "PostalAddress", "addressLocality": "Brisbane", "addressCountry": "AU" },
  "email": "hello@marriottsystems.net",
  "priceRange": "$300–$1,500",
  "parentOrganization": { "@id": "https://marriottsystems.net/#organization" },
};
---

<Base
  title="Operations systems for hospitality – Marriott Systems"
  description="Custom operational systems for Brisbane restaurants, cafes, and bars – pulling POS, bookings, and accounting into one place. Builds from $1.5k, fixed scope."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

  <section class="hero container" aria-labelledby="hero-heading">
    <p class="section-label" data-reveal><span aria-hidden="true">01 / </span>hospitality</p>
    <h1 id="hero-heading" class="hero__headline" data-reveal>
      Operational systems for hospitality venues.
    </h1>
    <p class="hero__lede" data-reveal>
      Marriott Systems pulls a venue's existing tools – POS, bookings, and accounting – into
      one operational system that shows owners what is actually happening. Built in Brisbane,
      for independent restaurants, cafes, and bars.
    </p>
    <div class="hero__actions" data-reveal>
      <a class="btn-pill" href="#services">see services &amp; prices <span aria-hidden="true">→</span></a>
      <a class="link-cta" href="#contact">book a call <span class="link-cta__arrow" aria-hidden="true">→</span></a>
    </div>
    <p class="cross-link mono" data-reveal>
      Building a website too? Websites for venues live at <a href="/web">/web</a>.
    </p>
  </section>

  <section class="stats container" aria-hidden="true" data-reveal>
    <div class="stat-grid">
      {stats.map((s) => (
        <div class="stat-grid__cell">
          <div class="stat-grid__value">{s.value}</div>
          <div class="stat-grid__label mono">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <section id="services" class="services container" aria-labelledby="services-heading">
    <p class="section-label"><span aria-hidden="true">02 / </span>services &amp; prices</p>
    <h2 id="services-heading" class="visually-hidden">Services</h2>
    <ol class="services__list grid-cards">
      {services.map((s) => (
        <li class="card services__item" data-reveal>
          <p class="services__index mono" aria-hidden="true">{s.index}</p>
          <h3 class="services__name">{s.name}</h3>
          <p class="services__price mono">{s.price}</p>
          <p class="services__body">{s.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="dashboard container" aria-labelledby="dashboard-heading">
    <p class="section-label"><span aria-hidden="true">03 / </span>the dashboard</p>
    <h2 id="dashboard-heading" class="dashboard__title" data-reveal>Live and in production.</h2>

    <div class="card proof__item" data-reveal>
      <h3 class="proof__name">
        <a href="https://demo.marriottsystems.net/dashboard" target="_blank" rel="noopener noreferrer">
          Restaurant finance dashboard <span class="proof__arrow" aria-hidden="true">↗</span>
        </a>
      </h3>
      <p class="proof__status mono">in production – brisbane pizzeria</p>
      <p class="proof__body">
        An operational dashboard a Brisbane pizzeria runs its end-of-service numbers on –
        daily sales, wages, COGS, and profitability across daily, weekly, monthly, and
        financial-year views. A live demo with simulated data is available at the link.
      </p>
    </div>

    <div class="dashboard__detail">
      <div class="terminal" data-reveal>
        <div class="terminal__bar">
          <span class="terminal__dot"></span>
          <span class="terminal__dot"></span>
          <span class="terminal__dot"></span>
          <span class="terminal__label">morning read</span>
        </div>
        <div class="terminal__body">
          <p><span class="terminal__prompt">»</span> revenue</p>
          <p><span class="terminal__prompt">»</span> cogs — food &amp; bev</p>
          <p><span class="terminal__prompt">»</span> labour</p>
          <p><span class="terminal__prompt">»</span> prime cost</p>
        </div>
      </div>
      <p class="dashboard__body" data-reveal>
        Every morning, the dashboard surfaces revenue, cost of goods, labour, and prime cost
        from the previous day's trade – replacing the spreadsheets and the month-end scramble
        to reconstruct numbers from receipts. It connects to Square, Lightspeed, Kounta, and
        ResDiary, with a CSV fallback for anything else, and exports cleanly to Xero.
      </p>
    </div>
  </section>

  <section class="who container" aria-labelledby="who-heading">
    <p class="section-label"><span aria-hidden="true">04 / </span>who this is for</p>
    <h2 id="who-heading" class="who__title" data-reveal>Built for owner-operators, not head office.</h2>
    <p class="who__body" data-reveal>
      Marriott Systems builds for independent venues turning over roughly $500k–$3M a year,
      and for owner-operators who still cook, serve, or open.
    </p>
    <p class="who__body" data-reveal>
      Marriott Systems is run by <a href="https://jacobmarriott.com">Jacob Marriott</a>, a
      software engineer with five years in professional kitchens across Brisbane and
      Queenstown. That background shapes how everything here is built: systems are judged by
      whether an operator actually uses them at the end of service, not by how they look in a
      demo. Capacity is deliberately limited to a small number of venues at a time, so each
      build gets done properly.
    </p>
  </section>

  <section id="faq" class="faq container" aria-labelledby="faq-heading">
    <p class="section-label"><span aria-hidden="true">05 / </span>faq</p>
    <h2 id="faq-heading" class="faq__title">Common questions.</h2>
    <div class="faq__list" data-reveal>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary class="faq__question">
            <span>{f.q}</span>
            <span class="faq__icon" aria-hidden="true">+</span>
          </summary>
          <div class="faq__answer"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </section>

  <section id="contact" class="contact-wrap container" aria-labelledby="contact-heading">
    <p class="section-label"><span aria-hidden="true">06 / </span>get in touch</p>
    <div class="card card--lg contact" data-reveal>
      <div class="contact__text">
        <h2 id="contact-heading" class="contact__title">Start with a call, or start with the fit check.</h2>
        <p class="contact__body">
          Book a 20-minute intro call – no commitment. Every operations engagement starts with
          a free fit-check call, so you know whether the system is worth building before
          agreeing to anything.
        </p>
      </div>
      <p class="contact__cta-row">
        <a class="btn-pill" href="https://cal.com/jacobem1836/20-min-intro" target="_blank" rel="noopener noreferrer">
          book a call <span aria-hidden="true">→</span>
        </a>
        <a class="link-cta" href="mailto:hello@marriottsystems.net">
          hello@marriottsystems.net
        </a>
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(2.5rem, 2rem + 3vw, 4rem) clamp(2.5rem, 1.8rem + 3vw, 4rem);
    display: grid;
    gap: var(--space-6);
  }

  .hero__headline {
    font-size: var(--text-hero);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    max-width: 16ch;
  }

  .hero__lede {
    font-size: var(--text-lg);
    color: var(--muted);
    max-width: 58ch;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .cross-link {
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .stats {
    padding-block: 0 var(--space-8);
  }

  .stat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-card-sm);
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .stat-grid {
      grid-template-columns: 1fr;
    }
  }

  .stat-grid__cell {
    background: var(--surface);
    padding: var(--space-6);
  }

  .stat-grid__value {
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }

  .stat-grid__label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--muted);
    margin-top: var(--space-2);
  }

  .services {
    display: grid;
    gap: var(--space-8);
  }

  .services__list {
    padding: 0;
    margin: 0;
  }

  .services__item {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .services__index {
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .services__name {
    font-size: var(--text-xl);
  }

  .services__price {
    font-size: var(--text-xs);
    color: var(--accent);
    text-transform: lowercase;
  }

  .services__body {
    color: var(--muted);
  }

  .dashboard {
    display: grid;
    gap: var(--space-8);
  }

  .dashboard__title {
    font-size: var(--text-2xl);
  }

  .proof__item {
    display: grid;
    gap: var(--space-2);
  }

  .proof__name {
    font-size: var(--text-xl);
  }

  .proof__name a {
    color: inherit;
    border-bottom: 0;
  }

  .proof__name a:hover {
    color: var(--accent);
  }

  .proof__arrow {
    font-size: 0.65em;
    color: var(--muted);
  }

  .proof__status {
    font-size: var(--text-xs);
    color: var(--accent);
    text-transform: lowercase;
  }

  .proof__body {
    color: var(--muted);
  }

  .dashboard__detail {
    display: grid;
    gap: var(--space-6);
  }

  .dashboard__body {
    color: var(--muted);
    max-width: 58ch;
    align-self: center;
  }

  .terminal__body p {
    margin: 0;
    color: var(--muted);
  }

  .terminal__body p + p {
    margin-top: var(--space-2);
  }

  @media (min-width: 48rem) {
    .dashboard__detail {
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
      align-items: center;
    }
  }

  .who {
    display: grid;
    gap: var(--space-6);
  }

  .who__title,
  .faq__title,
  .contact__title {
    font-size: var(--text-2xl);
  }

  .who__body {
    color: var(--muted);
    max-width: 58ch;
  }

  .faq {
    display: grid;
    gap: var(--space-8);
  }

  .faq__list {
    max-width: var(--container-narrow);
    display: grid;
  }

  .faq__item {
    border-top: 1px solid var(--line);
  }

  .faq__item:last-child {
    border-bottom: 1px solid var(--line);
  }

  .faq__question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    cursor: pointer;
    list-style: none;
    font-weight: 500;
    color: var(--text);
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .faq__question::-webkit-details-marker { display: none; }
  .faq__question::marker { content: ""; }

  .faq__question:hover {
    color: var(--accent);
  }

  .faq__icon {
    font-family: var(--font-mono);
    color: var(--muted);
    flex-shrink: 0;
    transition: transform var(--duration-normal) var(--ease-out-expo);
  }

  details[open] .faq__icon {
    transform: rotate(45deg);
  }

  .faq__answer {
    padding-bottom: var(--space-4);
  }

  .faq__answer p {
    font-size: var(--text-sm);
    color: var(--muted);
    max-width: var(--measure-prose);
  }

  .contact-wrap {
    display: grid;
    gap: var(--space-6);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    align-items: center;
    justify-content: space-between;
  }

  .contact__body {
    color: var(--muted);
    max-width: 44ch;
    margin-top: var(--space-2);
  }

  .contact__cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    margin: 0;
  }
</style>
