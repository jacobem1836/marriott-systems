{
  "redirects": [
    {
      "source": "/dashboard",
      "destination": "https://chef-jon-pizzeria-dashboard.vercel.app/",
      "permanent": false
    },
    {
      "source": "/consulting",
      "destination": "https://jacobmarriott.com",
      "permanent": true
    },
    {
      "source": "/consult",
      "destination": "https://jacobmarriott.com",
      "permanent": true
    },
    {
      "source": "/hospitality",
      "destination": "https://jacobmarriott.com",
      "permanent": true
    },
    {
      "source": "/hospitality/:path*",
      "destination": "https://jacobmarriott.com",
      "permanent": true
    },
    {
      "source": "/hospitality-systems",
      "destination": "https://jacobmarriott.com",
      "permanent": true
    },
    {
      "source": "/web",
      "destination": "https://jacobmarriott.com",
      "permanent": true
    },
    {
      "source": "/web/:path*",
      "destination": "https://jacobmarriott.com",
      "permanent": true
    },
    {
      "source": "/audit",
      "destination": "https://jacobmarriott.com",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self';"
        }
      ]
    }
  ]
}
