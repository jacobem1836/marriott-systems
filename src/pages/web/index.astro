---
import Base from "../../layouts/Base.astro";

const services = [
  {
    index: "01",
    name: "Visibility audit",
    price: "$297 – delivered in 48 hours",
    body: "A review of your Google presence, your mobile site, and how you compare with two local competitors. Delivered as a short video walkthrough and a PDF fix list ranked by impact. If it leads to a rebuild, the $297 is credited against the price.",
    href: "/web/audit",
    cta: "order an audit",
  },
  {
    index: "02",
    name: "Website rebuild",
    price: "from $997",
    body: "A custom, mobile-first site built around your venue – menu integration, booking flows, local SEO, and copy written for you. No templates, no platform fees, and you own everything: the code, the design, and the domain.",
  },
  {
    index: "03",
    name: "Ongoing care",
    price: "from $47/mo",
    body: "Hosting, content edits, and a monthly visibility check.",
  },
];

const stats = [
  { value: "$297", label: "visibility audit" },
  { value: "$997", label: "website rebuild, from" },
  { value: "$47/mo", label: "ongoing care, from" },
];

const faqs = [
  {
    q: "How much of my time does this take?",
    a: "About an hour across a whole website project – a 20-minute call, half an hour reviewing the mockup, and a sign-off. Marriott Systems handles the design, copy, development, hosting, and launch.",
  },
  {
    q: "Do I need to write the text or supply images?",
    a: "No. All copy is written for you, based on the initial call. Photos of your venue or team help, but existing material is enough to work with.",
  },
  {
    q: "What if I don't like the design?",
    a: "The mockup is free. If it isn't right, it gets adjusted – or you walk away at no cost. Revision rounds are built into the process after sign-off.",
  },
  {
    q: "How long until it's live?",
    a: "Audits are delivered within 48 hours of payment. Most website projects go from first call to live site in two to three weeks; the build itself takes five to seven business days from mockup sign-off.",
  },
  {
    q: "Will it show up on Google – and in AI answers?",
    a: "Yes. Every site is built with local SEO structure from the start: proper headings, schema markup, fast load times, and mobile-first layout. Sites are also structured so AI tools such as ChatGPT and Google AI can read your services, location, and reviews – and surface your business when someone asks for a recommendation.",
  },
  {
    q: "Do I own the website?",
    a: "Yes. The code, the design, and the domain are yours, with no lock-in. Ongoing care is available if you would rather not think about it, but it is never required.",
  },
  {
    q: "Why not just use Wix or Squarespace?",
    a: "Template platforms are slower, harder to rank on Google, and carry ongoing platform fees. A custom site loads faster, converts better, and looks like your business rather than a theme.",
  },
  {
    q: "What if I'm not in Brisbane?",
    a: "Marriott Systems works with venues across South-East Queensland, and the audit and rebuild process is fully remote – no in-person meetings required.",
  },
];

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Marriott Systems – Web",
  "url": "https://marriottsystems.net/web",
  "description": "Website audits and rebuilds for Brisbane restaurants, cafes, and bars.",
  "areaServed": { "@type": "City", "name": "Brisbane" },
  "address": { "@type": "PostalAddress", "addressLocality": "Brisbane", "addressCountry": "AU" },
  "email": "hello@marriottsystems.net",
  "priceRange": "$297–$997",
  "parentOrganization": { "@id": "https://marriottsystems.net/#organization" },
};
---

<Base
  title="Hospitality websites – Marriott Systems"
  description="Website audits and rebuilds for Brisbane restaurants, cafes, and bars. Audits from $297, rebuilds from $997."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

  <section class="hero container" aria-labelledby="hero-heading">
    <p class="section-label" data-reveal><span aria-hidden="true">01 / </span>web</p>
    <h1 id="hero-heading" class="hero__headline" data-reveal>
      Websites for hospitality venues.
    </h1>
    <p class="hero__lede" data-reveal>
      Marriott Systems finds where a venue is losing customers online and fixes it – a custom,
      mobile-first site with menu integration, booking flows, local SEO, and copy written for
      you. Built in Brisbane, for independent restaurants, cafes, and bars.
    </p>
    <div class="hero__actions" data-reveal>
      <a class="btn-pill" href="#services">see services &amp; prices <span aria-hidden="true">→</span></a>
      <a class="link-cta" href="#contact">book a call <span class="link-cta__arrow" aria-hidden="true">→</span></a>
    </div>
    <p class="cross-link mono" data-reveal>
      Running the back-of-house too? Venue operations systems live at <a href="/hospitality">/hospitality</a>.
    </p>
  </section>

  <section class="stats container" aria-hidden="true" data-reveal>
    <div class="stat-grid">
      {stats.map((s) => (
        <div class="stat-grid__cell">
          <div class="stat-grid__value">{s.value}</div>
          <div class="stat-grid__label mono">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <section id="services" class="services container" aria-labelledby="services-heading">
    <p class="section-label"><span aria-hidden="true">02 / </span>services &amp; prices</p>
    <h2 id="services-heading" class="visually-hidden">Services</h2>
    <ol class="services__list grid-cards">
      {services.map((s) => (
        <li class="card services__item" data-reveal>
          <p class="services__index mono" aria-hidden="true">{s.index}</p>
          <h3 class="services__name">{s.name}</h3>
          <p class="services__price mono">{s.price}</p>
          <p class="services__body">{s.body}</p>
          {s.href && (
            <p class="services__cta-row">
              <a class="link-cta" href={s.href}>{s.cta} <span class="link-cta__arrow" aria-hidden="true">→</span></a>
            </p>
          )}
        </li>
      ))}
    </ol>
  </section>

  <section class="why container" aria-labelledby="why-heading">
    <p class="section-label"><span aria-hidden="true">03 / </span>why it matters</p>
    <h2 id="why-heading" class="why__title" data-reveal>Your customers are already searching.</h2>
    <p class="why__body" data-reveal>
      Someone searches for a venue, or asks an AI assistant for a recommendation – and your
      website is how they decide between you and the competitor down the road. 97% of people
      research local businesses online before making contact, 75% judge credibility by the
      website, and 46% of all Google searches are local.
    </p>
    <p class="why__body" data-reveal>
      Increasingly, those questions go to ChatGPT, Google AI, and Siri instead of a results
      page. These tools take their answers from websites: if yours is a generic template –
      or missing – you are invisible to them. Every Marriott Systems build is structured so
      search engines and AI tools can read your services, location, reviews, and contact
      details clearly. The goal is no longer just ranking; it is being the answer.
    </p>
  </section>

  <section class="proof container" aria-labelledby="proof-heading">
    <p class="section-label"><span aria-hidden="true">04 / </span>work</p>
    <h2 id="proof-heading" class="proof__title" data-reveal>Live and in production.</h2>
    <ul class="proof__list">
      <li class="card proof__item" data-reveal>
        <h3 class="proof__name">
          <a href="https://inapickle.com.au" target="_blank" rel="noopener noreferrer">
            In a Pickle <span class="proof__arrow" aria-hidden="true">↗</span>
          </a>
        </h3>
        <p class="proof__status mono">live – boutique caterer, brisbane</p>
        <p class="proof__body">
          A complete website for a Brisbane boutique caterer – catering, menus, blog, and
          online quotes and bookings, with an inline editor so the team updates content
          themselves.
        </p>
      </li>
    </ul>
    <blockquote class="proof__quote" data-reveal>
      <p>
        "Our website was in dire need of a major revamp and we were lucky enough to come across
        Jacob Marriott. His attention to detail and knowledge around an online presence has
        helped create a much more user-friendly platform for our clients to navigate. In the
        short time since we launched we have already noticed a major increase in traffic to the
        site. 100% recommend."
      </p>
      <footer class="mono">— in a pickle, boutique caterer, brisbane</footer>
    </blockquote>
  </section>

  <section id="faq" class="faq container" aria-labelledby="faq-heading">
    <p class="section-label"><span aria-hidden="true">05 / </span>faq</p>
    <h2 id="faq-heading" class="faq__title">Common questions.</h2>
    <div class="faq__list" data-reveal>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary class="faq__question">
            <span>{f.q}</span>
            <span class="faq__icon" aria-hidden="true">+</span>
          </summary>
          <div class="faq__answer"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </section>

  <section class="who container" aria-labelledby="who-heading">
    <p class="section-label"><span aria-hidden="true">06 / </span>who builds this</p>
    <h2 id="who-heading" class="who__title" data-reveal>A software company with a kitchen background.</h2>
    <p class="who__body" data-reveal>
      Marriott Systems is run by <a href="https://jacobmarriott.com">Jacob Marriott</a>, a
      software engineer with five years in professional kitchens across Brisbane and
      Queenstown. Capacity is deliberately limited to a small number of venues at a time, so each
      build gets done properly.
    </p>
  </section>

  <section id="contact" class="contact-wrap container" aria-labelledby="contact-heading">
    <p class="section-label"><span aria-hidden="true">07 / </span>get in touch</p>
    <div class="card card--lg contact" data-reveal>
      <div class="contact__text">
        <h2 id="contact-heading" class="contact__title">Start with a call, or start with the audit.</h2>
        <p class="contact__body">
          Book a 20-minute intro call – no commitment, and every website project starts with a
          free mockup so you can see what you would get before agreeing to anything. Or skip the
          call entirely and <a href="/web/audit">order the $297 audit</a>.
        </p>
      </div>
      <p class="contact__cta-row">
        <a class="btn-pill" href="https://cal.com/jacobem1836/20-min-intro" target="_blank" rel="noopener noreferrer">
          book a call <span aria-hidden="true">→</span>
        </a>
        <a class="link-cta" href="mailto:hello@marriottsystems.net">
          hello@marriottsystems.net
        </a>
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(2.5rem, 2rem + 3vw, 4rem) clamp(2.5rem, 1.8rem + 3vw, 4rem);
    display: grid;
    gap: var(--space-6);
  }

  .hero__headline {
    font-size: var(--text-hero);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    max-width: 16ch;
  }

  .hero__lede {
    font-size: var(--text-lg);
    color: var(--muted);
    max-width: 58ch;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .cross-link {
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .stats {
    padding-block: 0 var(--space-8);
  }

  .stat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-card-sm);
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .stat-grid {
      grid-template-columns: 1fr;
    }
  }

  .stat-grid__cell {
    background: var(--surface);
    padding: var(--space-6);
  }

  .stat-grid__value {
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }

  .stat-grid__label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--muted);
    margin-top: var(--space-2);
  }

  .services {
    display: grid;
    gap: var(--space-8);
  }

  .services__list {
    padding: 0;
    margin: 0;
  }

  .services__item {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .services__index {
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .services__name {
    font-size: var(--text-xl);
  }

  .services__price {
    font-size: var(--text-xs);
    color: var(--accent);
    text-transform: lowercase;
  }

  .services__body {
    color: var(--muted);
  }

  .services__cta-row {
    margin: var(--space-2) 0 0;
  }

  .why,
  .who {
    display: grid;
    gap: var(--space-6);
  }

  .why__title,
  .who__title,
  .proof__title,
  .faq__title,
  .contact__title {
    font-size: var(--text-2xl);
  }

  .why__body,
  .who__body {
    color: var(--muted);
    max-width: 58ch;
  }

  .proof {
    display: grid;
    gap: var(--space-8);
  }

  .proof__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-6);
  }

  .proof__item {
    display: grid;
    gap: var(--space-2);
  }

  .proof__name {
    font-size: var(--text-xl);
  }

  .proof__name a {
    color: inherit;
    border-bottom: 0;
  }

  .proof__name a:hover {
    color: var(--accent);
  }

  .proof__arrow {
    font-size: 0.65em;
    color: var(--muted);
  }

  .proof__status {
    font-size: var(--text-xs);
    color: var(--accent);
    text-transform: lowercase;
  }

  .proof__body {
    color: var(--muted);
  }

  .proof__quote {
    margin: 0;
    max-width: 62ch;
  }

  .proof__quote p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-xl);
    line-height: 1.3;
    letter-spacing: var(--tracking-tight);
    color: var(--text);
  }

  .proof__quote footer {
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .faq {
    display: grid;
    gap: var(--space-8);
  }

  .faq__list {
    max-width: var(--container-narrow);
    display: grid;
  }

  .faq__item {
    border-top: 1px solid var(--line);
  }

  .faq__item:last-child {
    border-bottom: 1px solid var(--line);
  }

  .faq__question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    cursor: pointer;
    list-style: none;
    font-weight: 500;
    color: var(--text);
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .faq__question::-webkit-details-marker { display: none; }
  .faq__question::marker { content: ""; }

  .faq__question:hover {
    color: var(--accent);
  }

  .faq__icon {
    font-family: var(--font-mono);
    color: var(--muted);
    flex-shrink: 0;
    transition: transform var(--duration-normal) var(--ease-out-expo);
  }

  details[open] .faq__icon {
    transform: rotate(45deg);
  }

  .faq__answer {
    padding-bottom: var(--space-4);
  }

  .faq__answer p {
    font-size: var(--text-sm);
    color: var(--muted);
    max-width: var(--measure-prose);
  }

  .contact-wrap {
    display: grid;
    gap: var(--space-6);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    align-items: center;
    justify-content: space-between;
  }

  .contact__body {
    color: var(--muted);
    max-width: 44ch;
    margin-top: var(--space-2);
  }

  .contact__cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    margin: 0;
  }
</style>
