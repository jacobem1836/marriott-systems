---
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/geist-mono/400.css";
import "@fontsource/geist-mono/500.css";
import "@fontsource-variable/newsreader";
import "../styles/global.css";

// Preload only the two faces visible above the fold on first paint: the
// serif display face (hero headline) and the sans body face.
import newsreaderLatinUrl from "@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url";
import interLatin400Url from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Marriott Systems – AI products and operational systems",
  description = "Marriott Systems is a Brisbane software company building AI products and operational systems for real businesses – Brain Console, dAIly, AI consulting, and hospitality systems. Founded by Jacob Marriott.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://marriottsystems.net/#organization",
  "name": "Marriott Systems",
  "url": "https://marriottsystems.net",
  "description": "Brisbane software company building AI products and operational systems for real businesses.",
  "founder": {
    "@type": "Person",
    "name": "Jacob Marriott",
    "url": "https://jacobmarriott.com",
  },
  "address": { "@type": "PostalAddress", "addressLocality": "Brisbane", "addressCountry": "AU" },
  "brand": [
    { "@type": "Brand", "name": "Brain Console", "url": "https://console.marriottsystems.net" },
    { "@type": "Brand", "name": "dAIly", "url": "https://getdaily.dev" },
  ],
  "sameAs": [
    "https://github.com/jacobem1836",
    "https://www.linkedin.com/in/jacob-marriott-1836-98a6571aa",
    "https://jacobmarriott.com",
  ],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "url": "https://marriottsystems.net",
  "name": "Marriott Systems",
  "publisher": { "@id": "https://marriottsystems.net/#organization" },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preload" as="font" type="font/woff2" href={newsreaderLatinUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interLatin400Url} crossorigin />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Marriott Systems" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://marriottsystems.net/og.png" />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://marriottsystems.net/og.png" />

    <link rel="canonical" href={canonicalURL} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__wordmark" href="/">marriott systems</a>
        <div class="site-header__cluster">
          <nav class="site-header__nav mono" aria-label="Sections">
            <a href="/consulting">consulting</a>
            <a href="/hospitality">hospitality</a>
            <a href="/web">web</a>
          </nav>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container site-footer__inner">
        <p class="site-footer__line mono">
          © 2026 Marriott Systems
          <span class="site-footer__dot" aria-hidden="true">·</span>
          Brisbane, AU
        </p>
        <p class="site-footer__line mono">
          <a href="https://jacobmarriott.com">founder</a>
          <span class="site-footer__dot" aria-hidden="true">·</span>
          <a href="https://github.com/jacobem1836" target="_blank" rel="noopener noreferrer">github</a>
          <span class="site-footer__dot" aria-hidden="true">·</span>
          <a href="https://www.linkedin.com/in/jacob-marriott-1836-98a6571aa" target="_blank" rel="noopener noreferrer">linkedin</a>
          <span class="site-footer__dot" aria-hidden="true">·</span>
          <a href="mailto:hello@marriottsystems.net">hello@marriottsystems.net</a>
        </p>
      </div>
    </footer>

    <script is:inline src="/interactions.js"></script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in oklab, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  .site-header__wordmark {
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.3125rem);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    color: var(--text);
    border-bottom: 0;
  }

  .site-header__wordmark:hover {
    color: var(--accent);
    border-bottom: 0;
  }

  .site-header__cluster {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 0.6rem + 0.8vw, 1.375rem);
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: clamp(0.625rem, 0.5rem + 0.6vw, 1.375rem);
    font-size: var(--text-xs);
  }

  .site-header__nav a {
    color: var(--muted);
    border-bottom: 0;
  }

  .site-header__nav a:hover,
  .site-header__nav a:focus-visible {
    color: var(--text);
    border-bottom: 0;
  }

  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: clamp(1.875rem, 1.5rem + 2vw, 3.75rem);
    padding-block: clamp(1.75rem, 1.4rem + 1.7vw, 2.75rem);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2) var(--space-6);
  }

  .site-footer__line {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .site-footer__line a {
    color: var(--muted);
    border-bottom: 0;
  }

  .site-footer__line a:hover,
  .site-footer__line a:focus-visible {
    color: var(--accent);
    border-bottom: 0;
  }

  .site-footer__dot {
    color: var(--line);
  }
</style>
